# Copy this file to .env and fill in your key. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Wikimedia (Wikipedia/Commons) refuses requests without contact info in the User-Agent (HTTP 403).
# Your email or a URL such as your GitHub profile. It is only sent to Wikimedia.
WIKI_CONTACT=

# Gemini models (free tier). Run `python -m egig doctor` to list what your key can use.
LLM_MODEL=gemini-3.5-flash-lite
VLM_MODEL=gemini-3.5-flash-lite

# Optional overrides (any Settings field in egig/config.py, in UPPERCASE)
# GENERATOR=auto        # auto | sdxl | collage   (auto = sdxl if a CUDA GPU exists, else collage)
# DETECTOR=auto         # auto | gdino | none
# MAX_ATTEMPTS=3
# IMAGE_SIZE=1024
# STEPS=25
# MAJOR_PASS_RATE=0.7
